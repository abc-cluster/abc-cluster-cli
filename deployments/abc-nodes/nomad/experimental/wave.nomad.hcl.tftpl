# wave.nomad.hcl.tftpl
# Managed by Terraform — rendered by templatefile() in main.tf.
#
# Wave Lite — container augmentation service (abc-experimental namespace)
#
# PURPOSE
# ───────
# Wave is Seqera's container augmentation service used by Nextflow pipelines.
# In "Lite" mode it provides container augmentation and Fusion filesystem
# support without the full build/mirror/scan infrastructure.
#
# DEPLOYMENT NODE: ${wave_node} (sun-nomadlab, docker driver)
# ─────────────────────────────────────────────────────────────
# Wave runs on ${wave_node} because it has the `docker` driver which natively
# supports HTTP registries via /etc/docker/daemon.json.  aither (the Consul
# server) only has the containerd-driver, which cannot pull from HTTP registries
# without complex host-level patching that proved unreliable.
#
# IMAGE — SELF-BUILD REQUIRED
# ───────────────────────────
# Wave has no public Docker image.  Build it and push to the local registry:
#
#   git clone https://github.com/seqeralabs/wave --branch ${wave_version} --depth 1
#   cd wave
#   # Push via jib through an SSH tunnel to ${wave_node}:5000
#   ssh -f -N -L 5000:localhost:5000 ${wave_node}
#   JAVA_HOME=/usr/local/opt/openjdk ./gradlew jib \
#     -PjibRepo=localhost:5000 \
#     -Djib.to.image=localhost:5000/wave:${wave_version}
#
#   # Or copy from the old aither registry (if the image is already there):
#   abc admin services nomad cli -- job run /tmp/copy-wave-image-to-nomad02.nomad.hcl
#
# ROUTING
# ───────
# Caddy on aither (abc-experimental-caddy-tailscale) reverse-proxies
# http://wave.aither → ${wave_ip}:9090 directly.  Traefik is NOT in the
# path for wave.aither; the consul-register sidecar's Traefik tags are kept
# for backwards compatibility but are not load-bearing.
#
# DOCKER INSECURE REGISTRY
# ────────────────────────
# Wave's container registry API is served over HTTP at ${wave_ip}:9090 and
# exposed via Caddy at http://wave.aither.  Docker on ${wave_node} must list
# "wave.aither" in /etc/docker/daemon.json insecure-registries so that Docker
# image pulls for wave-augmented images succeed.  A prestart task (docker-setup)
# configures this automatically on every deploy and restarts Docker if the entry
# was missing.
#
# For abc job run --wave-inject-tools to work on any node that runs docker-driver
# jobs, that node's /etc/docker/daemon.json must also include "wave.aither".
#
# DEPENDENCIES
# ────────────
#  PostgreSQL : ${pg_host}:5432  (abc-experimental-postgres, db=${pg_wave_db})
#               → wave-db-init prestart creates the wave database + user
#  Redis      : ${redis_uri}
#
# NEXTFLOW INTEGRATION
# ────────────────────
# In nextflow.config:
#   wave { enabled = true; endpoint = 'http://wave.aither' }
#   fusion { enabled = true }
#
# CLI CONFIGURATION
# ─────────────────
# Set the abc-wave URL in the active context so abc job run --wave-inject-tools
# can reach the REST API:
#   abc config set contexts.<name>.admin.services.wave.http http://${wave_ip}:9090
#
# ENDPOINTS
#   API / Nextflow : http://wave.aither  (Caddy → ${wave_ip}:9090)
#   Health         : http://wave.aither/health
#   Metrics        : http://wave.aither/metrics

job "abc-experimental-wave" {
  namespace = "abc-experimental"
  type      = "service"
  priority  = 50

  meta {
    abc_cluster_type = "abc-nodes"
    service          = "wave"
  }

  group "wave" {
    count = 1

    # Pin to ${wave_node} (docker driver, local registry at ${wave_ip}:5000).
    # PostgreSQL (${pg_host}:5432) and Redis (${redis_uri}) stay on aither
    # and are reached via their static Tailscale IPs.
    constraint {
      attribute = "$${attr.unique.hostname}"
      value     = "${wave_node}"
    }

    # Host networking — Wave binds directly to port 9090 on the host.
    # Required because the docker driver on ${wave_node} does not apply
    # group-level bridge/host mode automatically; network_mode in the task
    # config is the reliable way to set it.
    network {
      mode = "host"
      port "http" { static = 9090 }
    }

    restart {
      attempts = 3
      delay    = "30s"
      interval = "5m"
      mode     = "delay"
    }

    # ── Docker insecure-registry setup (prestart, idempotent) ────────────────
    # Ensures wave.aither is in /etc/docker/daemon.json on ${wave_node} so that
    # Docker can pull wave-augmented images over HTTP.  Uses python3 to parse and
    # update the JSON safely; restarts Docker only when the entry was absent.
    # Runs as raw_exec to operate on the host daemon, not inside a container.
    task "docker-setup" {
      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      driver = "raw_exec"

      config {
        command = "/bin/bash"
        args    = ["-c", <<-SCRIPT
set -e
DAEMON_JSON=/etc/docker/daemon.json
REGISTRY="wave.aither"

if [ -f "$DAEMON_JSON" ]; then
  CURRENT=$(cat "$DAEMON_JSON")
else
  CURRENT="{}"
fi

if echo "$CURRENT" | grep -q "\"$REGISTRY\""; then
  echo "docker-setup: $REGISTRY already in insecure-registries, skipping"
  exit 0
fi

python3 -c "
import json, sys
d = json.loads(sys.stdin.read())
regs = d.get('insecure-registries', [])
regs.append('$REGISTRY')
d['insecure-registries'] = regs
print(json.dumps(d, indent=2))
" <<< "$CURRENT" | sudo tee "$DAEMON_JSON"

echo "docker-setup: added $REGISTRY — restarting Docker..."
sudo systemctl restart docker
echo "docker-setup: done"
SCRIPT
        ]
      }

      resources {
        cpu    = 50
        memory = 32
      }
    }

    # ── DB bootstrap (prestart, idempotent) ───────────────────────────────────
    # Creates the '${pg_wave_db}' PostgreSQL database and ${pg_wave_user} if
    # they don't already exist.  The DO $$ ... $$ blocks make each step
    # idempotent — safe to re-run on every deployment.  Wave's Flyway
    # migrations handle schema creation on first start.
    task "wave-db-init" {
      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      # Uses the docker driver — psql comes from the postgres image rather than
      # requiring a host-side psql install.  postgres:15-alpine is a public image
      # pulled directly from Docker Hub.
      driver = "docker"

      config {
        image      = "postgres:15-alpine"
        entrypoint = ["/bin/sh", "-c"]
        args = [
          <<-EOC
          set -e
          export PGPASSWORD="${pg_admin_password}"

          echo "wave-db-init: ensuring ${pg_wave_user} exists..."
          psql -h ${pg_host} -U ${pg_admin_user} -d ${pg_admin_user} -c "
            DO \$\$
            BEGIN
              IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${pg_wave_user}') THEN
                CREATE ROLE ${pg_wave_user} LOGIN PASSWORD '$WAVE_DB_PASSWORD';
                RAISE NOTICE 'Created role ${pg_wave_user}';
              ELSE
                RAISE NOTICE 'Role ${pg_wave_user} already exists';
              END IF;
            END
            \$\$;
          "

          echo "wave-db-init: ensuring ${pg_wave_db} database exists..."
          psql -h ${pg_host} -U ${pg_admin_user} -d ${pg_admin_user} -c "
            SELECT 'CREATE DATABASE ${pg_wave_db} OWNER ${pg_wave_user}'
            WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${pg_wave_db}')
          " | grep -q 'CREATE DATABASE' && \
            psql -h ${pg_host} -U ${pg_admin_user} -d ${pg_admin_user} \
              -c "CREATE DATABASE ${pg_wave_db} OWNER ${pg_wave_user}" || \
            echo "wave-db-init: database ${pg_wave_db} already exists"

          echo "wave-db-init: granting schema privileges..."
          psql -h ${pg_host} -U ${pg_admin_user} -d ${pg_wave_db} -c "
            GRANT USAGE, CREATE ON SCHEMA public TO ${pg_wave_user};
            GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO ${pg_wave_user};
            GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO ${pg_wave_user};
            ALTER DEFAULT PRIVILEGES IN SCHEMA public
              GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO ${pg_wave_user};
            ALTER DEFAULT PRIVILEGES IN SCHEMA public
              GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO ${pg_wave_user};
          "

          echo "wave-db-init: done"
          EOC
        ]
      }

      env {
        WAVE_DB_PASSWORD = "${pg_wave_password}"
      }

      resources {
        cpu    = 100
        memory = 64
      }
    }

    # ── Wave Lite server ──────────────────────────────────────────────────────
    task "wave" {
      driver = "docker"

      config {
        image        = "${wave_image}"
        network_mode = "host"
        # HTTP pulls from ${wave_ip}:5000 (local registry) and wave.aither are
        # permitted via /etc/docker/daemon.json insecure-registries, configured
        # by the docker-setup prestart task above.
        # network_mode=host is required: the docker driver on ${wave_node} does
        # not apply group-level host mode automatically, so Wave would otherwise
        # bind inside a bridge network and port 9090 would not be reachable.
      }

      # ── Wave config.yml (Micronaut configuration) ─────────────────────────
      # Delivered via Nomad template so it is rendered into the alloc dir at
      # runtime.  MICRONAUT_CONFIG_FILES env var points Micronaut to this file.
      template {
        destination = "local/config.yml"
        data        = <<EOF
wave:
  server:
    url: "${wave_server_url}"
  allowAnonymous: true
  build:
    enabled: false
  mirror:
    enabled: false
  scan:
    enabled: false
  tokens:
    cache:
      duration: "36h"
  metrics:
    enabled: true

rate-limit:
  pull:
    anonymous: 250/1h
    authenticated: 2000/1m
  timeout-errors:
    max-rate: 100/1m

micronaut:
  netty:
    event-loops:
      default:
        num-threads: 16
  http:
    services:
      stream-client:
        read-timeout: "30s"
        read-idle-timeout: "5m"

endpoints:
  env:
    enabled: false
  bean:
    enabled: false
  caches:
    enabled: false
  refresh:
    enabled: false
  loggers:
    enabled: false
  info:
    enabled: false
  health:
    enabled: true
    disk-space:
      enabled: false
    jdbc:
      enabled: false
  metrics:
    enabled: true
EOF
      }

      env {
        # Micronaut profile activation.
        MICRONAUT_ENVIRONMENTS = "lite,rate-limit,redis,postgres,prometheus"

        # Point Micronaut at the config.yml rendered into the task dir.
        MICRONAUT_CONFIG_FILES = "$${NOMAD_TASK_DIR}/config.yml"

        # PostgreSQL — JDBC format (NOT the postgresql:// libpq scheme).
        WAVE_DB_URI  = "jdbc:postgresql://${pg_host}:5432/${pg_wave_db}"
        WAVE_DB_USER = "${pg_wave_user}"

        # Redis — Lettuce client format.
        REDIS_URI = "${redis_uri}"

        # AWS SDK requires a region even for non-AWS endpoints.
        AWS_DEFAULT_REGION = "us-east-1"

        WAVE_DB_PASSWORD = "${pg_wave_password}"
      }

      resources {
        # Micronaut JVM + netty event loop. 1500 MB is the minimum per Seqera docs.
        # Wave Lite without build overhead sits at ~800-1000 MB steady state.
        cpu    = 500
        memory = 1536
      }
    }

    # ── Consul registration sidecar ───────────────────────────────────────────
    # ${wave_node} has no Consul agent, so `service { provider = "consul" }` is
    # not available.  This raw_exec sidecar registers Wave directly against the
    # Consul server at ${consul_addr}, then deregisters cleanly on job stop via
    # SIGTERM trap.
    #
    # Routing: Caddy (abc-experimental-caddy-tailscale) proxies wave.aither
    # directly to ${wave_ip}:9090 — it does NOT go through Traefik.  The Traefik
    # tags below are kept for Prometheus scrape discovery and backwards compat.
    task "consul-register" {
      lifecycle {
        hook    = "poststart"
        sidecar = true
      }

      driver = "raw_exec"

      config {
        command = "/bin/bash"
        args    = ["$${NOMAD_TASK_DIR}/register.sh"]
      }

      template {
        destination = "local/register.sh"
        perms       = "755"
        data        = <<EOF
#!/bin/bash
set -e

CONSUL_ADDR="${consul_addr}"
SERVICE_ID="abc-experimental-wave-${wave_node}"
WAVE_ADDR="${wave_ip}"
WAVE_PORT=9090

cleanup() {
  echo "consul-register: deregistering $SERVICE_ID"
  curl -sf -X PUT "$CONSUL_ADDR/v1/agent/service/deregister/$SERVICE_ID" || true
  exit 0
}
trap cleanup SIGTERM SIGINT

echo "consul-register: registering $SERVICE_ID at $WAVE_ADDR:$WAVE_PORT"
curl -sf -X PUT "$CONSUL_ADDR/v1/agent/service/register" \
  -H "Content-Type: application/json" \
  -d "{
    \"ID\": \"$SERVICE_ID\",
    \"Name\": \"abc-experimental-wave\",
    \"Address\": \"$WAVE_ADDR\",
    \"Port\": $WAVE_PORT,
    \"Tags\": [
      \"abc-nodes\", \"wave\", \"experimental\",
      \"prometheus.scrape=true\",
      \"traefik.enable=true\",
      \"traefik.http.routers.wave.rule=Host(\\\"wave.aither\\\")\",
      \"traefik.http.routers.wave.entrypoints=web\",
      \"traefik.http.services.wave.loadbalancer.server.port=9090\"
    ],
    \"Check\": {
      \"HTTP\": \"http://$WAVE_ADDR:$WAVE_PORT/health\",
      \"Interval\": \"20s\",
      \"Timeout\": \"5s\",
      \"DeregisterCriticalServiceAfter\": \"2m\"
    }
  }"

echo "consul-register: registered. Sleeping until stopped..."
while true; do sleep 30; done
EOF
      }

      resources {
        cpu    = 50
        memory = 32
      }
    }
  }
}
