# docker-registry.nomad.hcl.tftpl
#
# OCI image registry for the abc-experimental tier — push locally-built
# containers from your laptop and pull them into Nomad jobs on the cluster.
# Backed by the upstream `registry:2` image (CNCF distribution/distribution).
#
# DEPLOYMENT NODE
# ───────────────
# Runs on ${registry_node} (a sun-nomadlab node with the `docker` driver).
# The `docker` driver is required because it natively handles HTTP (insecure)
# registries via daemon.json — the containerd-driver on aither cannot pull
# from HTTP registries without host-level patching that proved unreliable.
#
# Before deploying, configure Docker's insecure registries on ${registry_node}:
#   abc admin services nomad cli -- job run \
#     /tmp/setup-nomad02-docker-insecure-registry.nomad.hcl
#
# NETWORKING
# ──────────
# Host networking (network_mode = "host"): the registry container shares the
# host's network stack so it is directly accessible at ${registry_ip}:${registry_port}.
# No CNI or bridge networking required — simpler and avoids port-mapping issues
# seen with older Nomad docker driver versions.
#
# CONSUL REGISTRATION
# ───────────────────
# ${registry_node} has no Consul agent. A raw_exec sidecar registers the service
# directly against the Consul server at ${consul_addr}, enabling Traefik to
# route registry.aither → ${registry_ip}:${registry_port}.
# The sidecar deregisters cleanly on job stop via SIGTERM trap.
#
# PUSH WORKFLOW (from your laptop)
# ─────────────────────────────────
# Add to /etc/docker/daemon.json (or Docker Desktop → Docker Engine settings):
#   "insecure-registries": ["${registry_ip}:${registry_port}"]
# Then:
#   docker tag my-image:dev ${registry_ip}:${registry_port}/my-image:dev
#   docker push ${registry_ip}:${registry_port}/my-image:dev
#
# Without Docker daemon: use skopeo
#   skopeo copy --dest-tls-verify=false \
#     containers-storage:my-image:dev \
#     docker://${registry_ip}:${registry_port}/my-image:dev
#
# PULL WORKFLOW (Nomad jobs on ${registry_node})
# ───────────────────────────────────────────────
# The daemon.json insecure-registries entry handles it automatically.
# Jobspecs reference images as:
#   image = "${registry_ip}:${registry_port}/my-image:dev"

job "abc-experimental-docker-registry" {
  namespace = "abc-experimental"
  type      = "service"
  priority  = 60

  group "registry" {
    count = 1

    # Pin to the node that runs the docker driver.
    # Image data is stored in a Docker-managed volume on this node's filesystem;
    # rescheduling to a different node would start with an empty registry.
    constraint {
      attribute = "$${attr.unique.hostname}"
      value     = "${registry_node}"
    }

    # Host networking — registry binds directly to port ${registry_port} on the
    # host. Requires Docker daemon to be running and the port to be free.
    network {
      mode = "host"
      port "http" { static = ${registry_port} }
    }

    restart {
      attempts = 3
      delay    = "20s"
      interval = "5m"
      mode     = "delay"
    }

    update {
      max_parallel     = 1
      min_healthy_time = "15s"
      healthy_deadline = "5m"
      auto_revert      = false
    }

    # ── Main task: registry:2 ─────────────────────────────────────────────────

    task "registry" {
      driver = "docker"

      config {
        image        = "${registry_image}"
        network_mode = "host"
        # Persist image data across restarts and redeployments.
        # Directory is created automatically by Docker if it doesn't exist.
        volumes = ["/opt/nomad/data/docker-registry:/var/lib/registry"]
      }

      env {
        REGISTRY_HTTP_ADDR                        = "0.0.0.0:${registry_port}"
        REGISTRY_HTTP_RELATIVEURLS                = "true"
        REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY = "/var/lib/registry"
        # Allow image deletion via the registry API (needed by Wave layer eviction).
        REGISTRY_STORAGE_DELETE_ENABLED           = "true"
        REGISTRY_LOG_ACCESSLOG_DISABLED           = "true"
        REGISTRY_LOG_LEVEL                        = "info"
      }

      resources {
        cpu    = 200
        memory = 256
      }
    }

    # ── Consul registration sidecar ───────────────────────────────────────────
    # ${registry_node} has no Consul agent, so we cannot use
    # `service { provider = "consul" }`.  This sidecar registers the registry
    # directly against the Consul server via HTTP API and deregisters on stop.
    # Traefik on aither reads the Consul catalog and routes accordingly.

    task "consul-register" {
      lifecycle {
        hook    = "poststart"
        sidecar = true
      }

      driver = "raw_exec"

      config {
        command = "/bin/bash"
        args    = ["$${NOMAD_TASK_DIR}/register.sh"]
      }

      template {
        destination = "local/register.sh"
        perms       = "755"
        data        = <<EOF
#!/bin/bash
set -e

CONSUL_ADDR="${consul_addr}"
SERVICE_ID="abc-experimental-docker-registry-${registry_node}"
REG_ADDR="${registry_ip}"
REG_PORT=${registry_port}

cleanup() {
  echo "consul-register: deregistering $SERVICE_ID"
  curl -sf -X PUT "$CONSUL_ADDR/v1/agent/service/deregister/$SERVICE_ID" || true
  exit 0
}
trap cleanup SIGTERM SIGINT

echo "consul-register: registering $SERVICE_ID at $REG_ADDR:$REG_PORT"
curl -sf -X PUT "$CONSUL_ADDR/v1/agent/service/register" \
  -H "Content-Type: application/json" \
  -d "{
    \"ID\": \"$SERVICE_ID\",
    \"Name\": \"abc-experimental-docker-registry\",
    \"Address\": \"$REG_ADDR\",
    \"Port\": $REG_PORT,
    \"Tags\": [
      \"traefik.enable=true\",
      \"traefik.http.routers.docker-registry.rule=Host(\\\"registry.aither\\\")\",
      \"traefik.http.routers.docker-registry.entrypoints=web\"
    ],
    \"Check\": {
      \"HTTP\": \"http://$REG_ADDR:$REG_PORT/v2/\",
      \"Interval\": \"30s\",
      \"Timeout\": \"5s\",
      \"DeregisterCriticalServiceAfter\": \"2m\"
    }
  }"

echo "consul-register: registered. Sleeping until stopped..."
while true; do sleep 30; done
EOF
      }

      resources {
        cpu    = 50
        memory = 32
      }
    }
  }
}
